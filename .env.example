# Copy to .env next to docker-compose.yml. Every value is optional; defaults are in docker-compose.yml.

# Write endpoints (POST/PATCH/DELETE) require this key when set. Leave empty only on a private network.
VMDR_API_KEY=

# Host paths for the Nuclei binary and its template cache (Linux host).
NUCLEI_BIN=/usr/local/bin/nuclei
NUCLEI_TEMPLATES_DIR=/home/ubuntu/nuclei-templates

# Public port for the dashboard.
VMDR_HTTP_PORT=8080
VMDR_CORS_ORIGINS=http://localhost:8080

# Scan tuning (safe production defaults).
VMDR_NUCLEI_SEVERITIES=critical,high,medium
VMDR_NUCLEI_RATE_LIMIT=50
VMDR_NUCLEI_CONCURRENCY=10
VMDR_FULL_SCAN_CRON=0 2 * * *
VMDR_TEMPLATE_UPDATE_HOURS=24
VMDR_RESOLVE_AFTER_MISSES=2

# Container resource limits (docker compose). Values are Docker CPU counts and memory sizes.
VMDR_API_CPUS=1.0
VMDR_API_MEMORY=512M
VMDR_WORKER_CPUS=2.0
VMDR_WORKER_MEMORY=2G
VMDR_FRONTEND_CPUS=0.5
VMDR_FRONTEND_MEMORY=128M
