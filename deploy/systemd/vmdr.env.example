# Copy to /etc/vmdr/vmdr.env (chmod 640, owner root:vmdr). Shared by vmdr-api and vmdr-worker.
VMDR_DATABASE_URL=sqlite:////var/lib/vmdr/vmdr.db
VMDR_SCAN_WORKDIR=/var/lib/vmdr/scans
VMDR_NUCLEI_BIN=/usr/local/bin/nuclei
VMDR_NUCLEI_RATE_LIMIT=50
VMDR_NUCLEI_CONCURRENCY=10
VMDR_NUCLEI_RETRIES=1
VMDR_NUCLEI_TIMEOUT=5
VMDR_NUCLEI_SEVERITIES=critical,high,medium
VMDR_FULL_SCAN_CRON=0 2 * * *
VMDR_TEMPLATE_UPDATE_HOURS=24
VMDR_RESOLVE_AFTER_MISSES=2
# Strongly recommended: require this key on every write endpoint.
VMDR_API_KEY=change-me
VMDR_CORS_ORIGINS=https://vmdr.example.internal
